# Copy this file to .env.local for local development, and set the same three
# values in Vercel under Settings → Environment Variables for the deployed site.

# MongoDB Atlas connection string. Create a free cluster at mongodb.com/atlas,
# then Database → Connect → Drivers, and paste the string here.
# Replace <password> with your database user's real password.
MONGODB_URI="mongodb+srv://academiclead:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Database name. Leave as is unless you want a different one.
MONGODB_DB="academic_lead"

# The single password every faculty member types to enter the portal.
PORTAL_PASSWORD="Vignan@123"

# Random string used to sign session cookies. Must be at least 16 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Change this and everyone is signed out.
SESSION_SECRET="replace-this-with-a-long-random-string"
